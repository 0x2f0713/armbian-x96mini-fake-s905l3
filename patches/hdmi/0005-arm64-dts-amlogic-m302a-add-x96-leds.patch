From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: S905L3 local bring-up <noreply@example.invalid>
Date: Sun, 26 Jul 2026 00:00:00 +0000
Subject: [PATCH] arm64: dts: amlogic: m302a: add X96 front LEDs

The Android firmware DTB for this X96 Mini style S905L3 board exposes two
front LEDs: a system LED on GPIODV_24 and a network LED on GPIOAO_9. Add them
to the HDMI/eMMC M302A DTB so fresh Armbian boots create sysfs LED controls
without needing the older non-HDMI LED DTB artifact.

Signed-off-by: S905L3 local bring-up <noreply@example.invalid>
---
 arch/arm64/boot/dts/amlogic/meson-gxl-s905l3b-m302a.dts | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/arch/arm64/boot/dts/amlogic/meson-gxl-s905l3b-m302a.dts b/arch/arm64/boot/dts/amlogic/meson-gxl-s905l3b-m302a.dts
index 70e020338..a4b171bf8 100644
--- a/arch/arm64/boot/dts/amlogic/meson-gxl-s905l3b-m302a.dts
+++ b/arch/arm64/boot/dts/amlogic/meson-gxl-s905l3b-m302a.dts
@@ -18,6 +18,23 @@ memory@0 {
 		reg = <0x0 0x0 0x0 0x80000000>;
 	};
 
+	leds {
+		compatible = "gpio-leds";
+
+		led-sys {
+			label = "x96:blue:sys";
+			gpios = <&gpio GPIODV_24 GPIO_ACTIVE_HIGH>;
+			default-state = "on";
+			linux,default-trigger = "heartbeat";
+		};
+
+		led-net {
+			label = "x96:blue:net";
+			gpios = <&gpio_ao GPIOAO_9 GPIO_ACTIVE_HIGH>;
+			default-state = "off";
+		};
+	};
+
 };
 
 // the gpu in the S905L2 has one pp core less
-- 
